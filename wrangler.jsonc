{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "unslop",
  "account_id": "198b4eeead855393592a983a0dc8f539",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "unslop.site",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "LOGO_GALLERY",
      "bucket_name": "unslop"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unslop-site",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGO_GENERATION_CLIENT_RATE_LIMITER",
      "namespace_id": "2026082602",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "LOGO_GENERATION_RATE_LIMITER",
      "namespace_id": "2026082601",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  }
}
